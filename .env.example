# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Port the backend HTTP server listens on (default: 3000).
PORT=3000

# SQLite database file; relative paths resolve from the repo root (default: data/rag.db).
DATABASE_PATH=data/rag.db

# --- LLM roles (tagger, query translator, judge, generator) ---
# The backend validates these at startup and refuses to start if they are invalid.

# Default provider for every role: anthropic | claude-code | fake (required).
# "claude-code" runs the local `claude` CLI on your Claude Code subscription instead of the API
# (no ANTHROPIC_API_KEY; slow, meant for evaluation runs, see eval:run).
# "fake" gives deterministic answers without network access or an API key.
LLM_PROVIDER=anthropic

# Default model for every role that uses provider anthropic or claude-code.
LLM_MODEL=claude-opus-5-5

# Optional per-role overrides of provider and model. ROLE is TAGGER, QUERY_TRANSLATOR,
# JUDGE or GENERATOR, e.g.:
# LLM_GENERATOR_MODEL=claude-sonnet-5-5
# LLM_JUDGE_PROVIDER=fake
LLM_TAGGER_PROVIDER=
# Picking tags from a list does not need a large model; a full tagging run is estimated at well under 1 USD.
LLM_TAGGER_MODEL=claude-haiku-5-5
LLM_QUERY_TRANSLATOR_PROVIDER=
LLM_QUERY_TRANSLATOR_MODEL=
LLM_JUDGE_PROVIDER=
LLM_JUDGE_MODEL=
LLM_GENERATOR_PROVIDER=
LLM_GENERATOR_MODEL=

# Anthropic API key, required when any role uses provider anthropic.
ANTHROPIC_API_KEY=

# Timeout per LLM request attempt in milliseconds, 1–2147483647 (default: 600000).
LLM_TIMEOUT_MS=600000

# Retries after a failed attempt on network errors, timeouts, 429 and 5xx, 0–10 (default: 2).
LLM_MAX_RETRIES=2

# --- Chunking (npm run data:chunk) ---
# Maximum length of a chunk's text in characters (default: 2000).
CHUNK_MAX_CHARS=2000
# Pieces of a split shorter than this many characters are merged with a neighbour when they fit;
# must be less than CHUNK_MAX_CHARS (default: 200).
CHUNK_MIN_CHARS=200

# --- Tagging (npm run index:tag) ---
# How many chunks are tagged at the same time (default: 4).
TAGGER_CONCURRENCY=4
# A tag on more than this share of the chunks with tags is reported as broad, 0–1 (default: 0.2).
TAG_REPORT_BROAD_SHARE=0.2

# --- Search index (built at server start; npm run bench:index) ---
# The tag index implementation: roaring (inverted index, default) or bloom (bit-sliced bloom filter).
TAG_INDEX=roaring
# Bloom filter only: bits per chunk signature (default: 128) and bits set per tag (default: 6,
# at most BLOOM_BITS).
BLOOM_BITS=128
BLOOM_HASHES=6
# Bloom filter only: check candidates against the exact tags, removing false positives (default: true).
BLOOM_VERIFY=true
# Below this many tag candidates, full-text search (SQLite FTS5) fills up (default: 10).
MIN_TAG_CANDIDATES=10
# At most this many candidates per query, from tags and full text together (default: 30).
MAX_CANDIDATES=30

# --- Query translation (instruction → tags) ---
# llm (default; uses the query translator's LLM provider and model above) or jev.
QUERY_TRANSLATOR_IMPL=llm
# JEV only: a tag is selected when JEV scores it at least this, 0–1 (default: 0.5).
QUERY_TRANSLATOR_THRESHOLD=0.5

# --- Judging (is a candidate chunk relevant to the instruction?) ---
# jev-with-fallback (default; JEV, and the judge's LLM above when JEV fails), jev or llm.
# Without JEV_API_KEY, jev-with-fallback logs a warning at startup and uses the LLM.
JUDGE_IMPL=jev-with-fallback
# A chunk is relevant when its score is at least this, 0–1, for JEV and the LLM (default: 0.5).
JUDGE_THRESHOLD=0.5
# JEV's per-call timeout when judging, in milliseconds; replaces JEV_TIMEOUT_MS there (default: 10000).
JUDGE_TIMEOUT_MS=10000
# A query's candidates are judged in parallel, at most this many calls at a time (default: 8).
JUDGE_CONCURRENCY=8
# One chunk's judgement, LLM fallback included, may take this long; then it is unknown (default: 30000).
JUDGE_CHUNK_TIMEOUT_MS=30000
# Judging all of a query's candidates may take this long; chunks not judged by then are unknown
# (default: 60000).
JUDGE_TOTAL_TIMEOUT_MS=60000
# on (default) or off: reuse judge scores per instruction and chunk from the database. Use off for
# timing measurements.
JUDGE_CACHE=on

# --- JEV (TypeSafe, https://docs.typesafe.ai) ---
# Required when QUERY_TRANSLATOR_IMPL=jev or JUDGE_IMPL=jev; used by JUDGE_IMPL=jev-with-fallback.
JEV_API_KEY=
# API root; requests go to <JEV_BASE_URL>/systemone (default: https://api.typesafe.ai/v1).
JEV_BASE_URL=https://api.typesafe.ai/v1
# The JEV model (default: jev-latest).
JEV_MODEL=jev-latest
# Per-call timeout in milliseconds; no retries (default: 30000).
JEV_TIMEOUT_MS=30000
