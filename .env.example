# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Port the backend HTTP server listens on (default: 3000).
PORT=3000

# SQLite database file; relative paths resolve from the repo root (default: data/rag.db).
DATABASE_PATH=data/rag.db

# --- LLM roles (tagger, query translator, judge, generator) ---
# The backend validates these at startup and refuses to start if they are invalid.

# Default provider for every role: anthropic | claude-code | fake (required).
# "claude-code" runs the local `claude` CLI on your Claude Code subscription instead of the API
# (no ANTHROPIC_API_KEY; slow, meant for evaluation runs, see eval:run).
# "fake" gives deterministic answers without network access or an API key.
LLM_PROVIDER=anthropic

# Default model for every role that uses provider anthropic or claude-code.
LLM_MODEL=claude-opus-5-5

# Optional per-role overrides of provider and model. ROLE is TAGGER, QUERY_TRANSLATOR,
# JUDGE or GENERATOR, e.g.:
# LLM_GENERATOR_MODEL=claude-sonnet-5-5
# LLM_JUDGE_PROVIDER=fake
LLM_TAGGER_PROVIDER=
# Picking tags from a list does not need a large model; a full tagging run is estimated at well under 1 USD.
LLM_TAGGER_MODEL=claude-haiku-5-5
LLM_QUERY_TRANSLATOR_PROVIDER=
LLM_QUERY_TRANSLATOR_MODEL=
LLM_JUDGE_PROVIDER=
# The judge answers one yes/no question per chunk; a small, fast model is the point (E7-7).
LLM_JUDGE_MODEL=claude-haiku-5-5
LLM_GENERATOR_PROVIDER=
LLM_GENERATOR_MODEL=

# Anthropic API key, required when any role uses provider anthropic.
ANTHROPIC_API_KEY=

# Timeout per LLM request attempt in milliseconds, 1–2147483647 (default: 600000).
LLM_TIMEOUT_MS=600000

# Retries after a failed attempt on network errors, timeouts, 429 and 5xx, 0–10 (default: 2).
LLM_MAX_RETRIES=2

# --- Chunking (npm run data:chunk) ---
# Maximum length of a chunk's text in characters (default: 2000).
CHUNK_MAX_CHARS=2000
# Pieces of a split shorter than this many characters are merged with a neighbour when they fit;
# must be less than CHUNK_MAX_CHARS (default: 200).
CHUNK_MIN_CHARS=200

# --- Tagging (npm run index:tag) ---
# How many chunks are tagged at the same time (default: 4).
TAGGER_CONCURRENCY=4
# A tag on more than this share of the chunks with tags is reported as broad, 0–1 (default: 0.2).
TAG_REPORT_BROAD_SHARE=0.2

# --- Search index (built at server start; npm run bench:index) ---
# The tag index implementation: roaring (inverted index, default) or bloom (bit-sliced bloom filter).
TAG_INDEX=roaring
# Bloom filter only: bits per chunk signature (default: 128) and bits set per tag (default: 6,
# at most BLOOM_BITS).
BLOOM_BITS=128
BLOOM_HASHES=6
# Bloom filter only: check candidates against the exact tags, removing false positives (default: true).
BLOOM_VERIFY=true
# Below this many tag candidates, full-text search (SQLite FTS5) fills up (default: 10).
MIN_TAG_CANDIDATES=10
# At most this many candidates per query, from tags and full text together (default: 30).
MAX_CANDIDATES=30

# --- Retrieval (where candidates come from, E8-4) ---
# tags (default; tag search with the full-text fallback above), bge (bge-m3 hybrid search: dense
# vectors and FTS5 BM25, fused) or both (tags and bge fused). bge and both need `npm run index:embed`
# first; bge needs no query translation.
RETRIEVER=tags
# bge and both: at most this many candidates go to the reranker (positive integer, default 20;
# E7-4's sweep found 20 better than 40 for both, and half the rerank). tags keeps MAX_CANDIDATES.
RETRIEVE_CANDIDATES=20
# Reciprocal rank fusion: each ranking adds weight / (RRF_K + rank) (positive integer, default 60).
RRF_K=60
# Each ranking's weight in the fusion, 0–1 (default 1; 0 switches a ranking off).
RRF_WEIGHT_DENSE=1
RRF_WEIGHT_LEXICAL=1
RRF_WEIGHT_TAGS=1

# --- Query translation (instruction → tags) ---
# llm (default; uses the query translator's LLM provider and model above), subq (SubQ; needs
# SUBQ_API_KEY, every call is billed) or jev (paused: JEV has never been called live).
QUERY_TRANSLATOR_IMPL=llm
# subq and jev only: a tag is selected when the model scores it at least this, 0–1 (default: 0.5).
QUERY_TRANSLATOR_THRESHOLD=0.5

# --- Reranking (which candidate chunks are relevant to the instruction?) ---
# The reranker: llm (default; the judge's LLM above says yes or no per chunk against
# JUDGE_THRESHOLD), subq (SubQ, with the judge's LLM for a SubQ call that fails; needs SUBQ_API_KEY,
# every call is billed), jev (the same with JEV; paused, needs JEV_API_KEY), minilm (local mMiniLM-L12, small and fast, but it only ranks: see
# MODEL_CACHE_DIR), bge (local bge-reranker-v2-m3, larger and slower, also only ranks) or qwen3
# (placeholder, not implemented). Replaces JUDGE_IMPL, which is rejected at startup.
RERANKER=llm
# A rerank keeps at most this many relevant chunks, best first (positive integer, default 8, best
# for tags in E7-4's sweep; with RETRIEVER=both, 12 was better).
RERANK_TOP_K=8
# bge only: a chunk is relevant when its score is at least this, 0–1 (default 0: only RERANK_TOP_K
# cuts). BGE's scores are not calibrated like a judge's, so JUDGE_THRESHOLD does not apply.
RERANK_THRESHOLD_BGE=0
# minilm only: the same, for mMiniLM's scores (default 0).
RERANK_THRESHOLD_MINILM=0
# bge and minilm: int8 (default; quantised) or fp32, and pairs per model call (default 8).
RERANKER_DTYPE=int8
RERANKER_BATCH_SIZE=8

# --- Judging (the subq, jev and llm rerankers) ---
# A chunk is relevant when its score is at least this, 0–1. Empty uses the judge's default: 0.8 for
# the LLM (the best central F1 in E7-7's sweep with the Haiku judge), 0.6 for SubQ (the same in
# E9-1's sweep), 0.5 for JEV until #79.
JUDGE_THRESHOLD=
# SubQ's or JEV's per-call timeout when judging, in milliseconds; replaces SUBQ_TIMEOUT_MS or
# JEV_TIMEOUT_MS there (default: 10000).
JUDGE_TIMEOUT_MS=10000
# A query's candidates are judged in parallel, at most this many calls at a time (default: 8).
JUDGE_CONCURRENCY=8
# One chunk's judgement, LLM fallback included, may take this long; then it is unknown (default: 30000).
JUDGE_CHUNK_TIMEOUT_MS=30000
# Judging all of a query's candidates may take this long; chunks not judged by then are unknown
# (default: 60000).
JUDGE_TOTAL_TIMEOUT_MS=60000
# on (default) or off: reuse judge scores per instruction and chunk from the database. Use off for
# timing measurements.
JUDGE_CACHE=on

# --- Generator (E6-2) ---
# The approved chunks go to the generator best first until either limit is reached; the rest are
# left out and the query output says so. `npm run query` can raise both for one run with
# --max-chunks and --max-context-chars.
# Most chunks per draft (positive integer, default 20).
GENERATOR_MAX_CHUNKS=20
# Most characters of chunk text per draft (positive integer, default 60000, about 15k tokens).
GENERATOR_MAX_CONTEXT_CHARS=60000

# --- Reference RAG (npm run query -- --reference, npm run bench:compare) ---
# No settings of its own: it judges the MAX_CANDIDATES chunks most similar to the instruction with
# the LLM judge (JUDGE_THRESHOLD, RERANK_TOP_K). REFERENCE_TOP_K was removed and is rejected.

# --- Local models (bge-m3, bge-reranker-v2-m3) ---
# Downloaded from Hugging Face on first use into this directory; relative paths resolve from the
# repo root (default: data/models.nosync, git-ignored; `.nosync` keeps iCloud Drive from uploading
# it when the repo is in a synced folder). Both models in both precisions take about 5.6 GB.
MODEL_CACHE_DIR=data/models.nosync

# --- Embeddings ---
# The embedder for vector retrieval: bge (bge-m3, local, dense vectors).
EMBEDDER=bge
# int8 (default; quantised, about a quarter of the memory) or fp32.
EMBEDDER_DTYPE=int8
# Texts per model call (positive integer, default 8).
EMBEDDER_BATCH_SIZE=8

# --- SubQ (Subquadratic, https://docs.subq.ai) ---
# Required when QUERY_TRANSLATOR_IMPL=subq or RERANKER=subq. Every call is billed ($0.05 per million
# input tokens): subq:probe, eval:run and bench:compare print an estimate first and go on only when
# confirmed (or with --yes).
SUBQ_API_KEY=
# API root; requests go to <SUBQ_BASE_URL>/systemone (default: https://api.subq.ai/v1).
SUBQ_BASE_URL=https://api.subq.ai/v1
# The decision model (default: subq-snap-preview).
SUBQ_MODEL=subq-snap-preview
# Per-call timeout in milliseconds; no retries (default: 30000).
SUBQ_TIMEOUT_MS=30000

# --- JEV (TypeSafe, https://docs.typesafe.ai; paused, see #79) ---
# Required when QUERY_TRANSLATOR_IMPL=jev or RERANKER=jev.
JEV_API_KEY=
# API root; requests go to <JEV_BASE_URL>/systemone (default: https://api.typesafe.ai/v1).
JEV_BASE_URL=https://api.typesafe.ai/v1
# The JEV model (default: jev-latest).
JEV_MODEL=jev-latest
# Per-call timeout in milliseconds; no retries (default: 30000).
JEV_TIMEOUT_MS=30000
