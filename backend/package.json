{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --expose-gc --env-file-if-exists=../.env src/server.ts",
    "start": "node --expose-gc --env-file-if-exists=../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/cli.ts migrate",
    "db:reset": "tsx --env-file-if-exists=../.env src/db/cli.ts reset",
    "data:fetch": "tsx --env-file-if-exists=../.env src/ingest/cli.ts fetch",
    "data:import:laws": "tsx --env-file-if-exists=../.env src/ingest/cli.ts import:laws",
    "data:import:rulings": "tsx --env-file-if-exists=../.env src/ingest/cli.ts import:rulings",
    "data:chunk": "tsx --env-file-if-exists=../.env src/ingest/cli.ts chunk",
    "index:vocabulary": "tsx --env-file-if-exists=../.env src/tagging/cli.ts vocabulary",
    "index:tag": "tsx --env-file-if-exists=../.env src/tagging/cli.ts tag",
    "index:report": "tsx --env-file-if-exists=../.env src/tagging/cli.ts report",
    "index:embed": "tsx --env-file-if-exists=../.env src/retrieval/cli.ts embed",
    "retrieve": "tsx --env-file-if-exists=../.env src/retrieval/cli.ts retrieve",
    "bench:index": "tsx --expose-gc --env-file-if-exists=../.env src/search/bench.ts",
    "jev:probe": "tsx --env-file-if-exists=../.env src/judge/probe.ts",
    "models:bench": "tsx --env-file-if-exists=../.env src/models/bench.ts",
    "bench:rerank": "tsx --env-file-if-exists=../.env src/rerank/bench.ts",
    "embed:smoke": "tsx --env-file-if-exists=../.env src/embedding/smoke.ts",
    "eval:label": "tsx --env-file-if-exists=../.env src/eval/cli.ts label",
    "eval:run": "tsx --env-file-if-exists=../.env src/eval/cli.ts run",
    "bench:compare": "tsx --env-file-if-exists=../.env src/eval/cli.ts bench",
    "query": "tsx --env-file-if-exists=../.env src/generation/cli.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "fastify": "^5.12.5",
    "roaring-wasm": "^1.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
