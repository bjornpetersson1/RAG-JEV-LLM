{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/cli.ts migrate",
    "db:reset": "tsx --env-file-if-exists=../.env src/db/cli.ts reset",
    "data:fetch": "tsx --env-file-if-exists=../.env src/ingest/cli.ts fetch",
    "data:import:laws": "tsx --env-file-if-exists=../.env src/ingest/cli.ts import:laws",
    "data:import:rulings": "tsx --env-file-if-exists=../.env src/ingest/cli.ts import:rulings"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
